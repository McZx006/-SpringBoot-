{"ast":null,"code":"import request from '../api/request';\nexport default {\n  data() {\n    return {\n      form: {\n        username: 'admin',\n        password: '123456',\n        role: 'admin'\n      }\n    };\n  },\n  methods: {\n    async login() {\n      const res = await request.post('/auth/login', this.form);\n      localStorage.setItem('adminToken', res.data.data.token);\n      this.$router.push('/admin/dashboard');\n    }\n  }\n};","map":{"version":3,"names":["request","data","form","username","password","role","methods","login","res","post","localStorage","setItem","token","$router","push"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\n  <div class=\"login-card\">\n    <h1>后台登录</h1>\n    <el-form>\n      <el-form-item label=\"账号\">\n        <el-input v-model=\"form.username\" />\n      </el-form-item>\n      <el-form-item label=\"密码\">\n        <el-input v-model=\"form.password\" type=\"password\" />\n      </el-form-item>\n      <el-button type=\"primary\" class=\"full-btn\" @click=\"login\">登录</el-button>\n    </el-form>\n  </div>\n</template>\n\n<script>\nimport request from '../api/request'\n\nexport default {\n  data() {\n    return {\n      form: { username: 'admin', password: '123456', role: 'admin' }\n    }\n  },\n  methods: {\n    async login() {\n      const res = await request.post('/auth/login', this.form)\n      localStorage.setItem('adminToken', res.data.data.token)\n      this.$router.push('/admin/dashboard')\n    }\n  }\n}\n</script>\n"],"mappings":"AAgBA,OAAAA,OAAA;AAEA;EACAC,KAAA;IACA;MACAC,IAAA;QAAAC,QAAA;QAAAC,QAAA;QAAAC,IAAA;MAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,MAAA;MACA,MAAAC,GAAA,SAAAR,OAAA,CAAAS,IAAA,qBAAAP,IAAA;MACAQ,YAAA,CAAAC,OAAA,eAAAH,GAAA,CAAAP,IAAA,CAAAA,IAAA,CAAAW,KAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}