{"ast":null,"code":"import request from '../api/request';\nexport default {\n  data() {\n    return {\n      keyword: '',\n      paperId: '',\n      papers: [],\n      rows: [],\n      dialogVisible: false,\n      editing: false,\n      form: this.defaultForm()\n    };\n  },\n  computed: {\n    dialogTitle() {\n      return this.editing ? '编辑试题' : '新增试题';\n    }\n  },\n  async created() {\n    await this.loadPapers();\n    await this.loadRows();\n  },\n  methods: {\n    async loadPapers() {\n      const res = await request.get('/exampapers/page', {\n        params: {\n          page: 1,\n          limit: 100\n        }\n      });\n      this.papers = res.data.data.list;\n    },\n    async loadRows() {\n      const res = await request.get('/examquestions/page', {\n        params: {\n          page: 1,\n          limit: 20,\n          keyword: this.keyword,\n          paperId: this.paperId || undefined\n        }\n      });\n      this.rows = res.data.data.list;\n    },\n    reset() {\n      this.keyword = '';\n      this.paperId = '';\n      this.loadRows();\n    },\n    openCreate() {\n      this.editing = false;\n      this.form = this.defaultForm();\n      this.dialogVisible = true;\n    },\n    openEdit(row) {\n      this.editing = true;\n      this.form = Object.assign(this.defaultForm(), row);\n      this.dialogVisible = true;\n    },\n    applyTypeTemplate() {\n      if (this.form.questionType === 'judge') {\n        this.form.optionsJson = '[{\"key\":\"A\",\"value\":\"对\"},{\"key\":\"B\",\"value\":\"错\"}]';\n        this.form.answer = 'A';\n      } else if (this.form.questionType === 'fill') {\n        this.form.optionsJson = '[]';\n      } else if (!this.form.optionsJson || this.form.optionsJson === '[]') {\n        this.form.optionsJson = '[{\"key\":\"A\",\"value\":\"\"},{\"key\":\"B\",\"value\":\"\"},{\"key\":\"C\",\"value\":\"\"},{\"key\":\"D\",\"value\":\"\"}]';\n      }\n    },\n    validate() {\n      if (!this.form.paperId) return '请选择所属试卷';\n      if (!this.form.questionName.trim()) return '请输入题目';\n      if (!this.form.answer.trim()) return '请输入答案';\n      if (!this.form.analysis.trim()) return '请输入题目解析';\n      try {\n        const options = JSON.parse(this.form.optionsJson || '[]');\n        if ((this.form.questionType === 'single' || this.form.questionType === 'multiple') && (!Array.isArray(options) || options.length < 2)) {\n          return '单选题和多选题至少需要两个选项';\n        }\n        if (this.form.questionType === 'judge' && (!Array.isArray(options) || options.length !== 2)) {\n          return '判断题必须保留两个选项';\n        }\n      } catch (error) {\n        return '选项JSON格式不正确';\n      }\n      return '';\n    },\n    async submit() {\n      const error = this.validate();\n      if (error) {\n        this.$message.warning(error);\n        return;\n      }\n      if (this.editing) {\n        await request.put('/examquestions/update', this.form);\n      } else {\n        await request.post('/examquestions/save', this.form);\n      }\n      this.dialogVisible = false;\n      await this.loadRows();\n    },\n    async remove(id) {\n      await this.$confirm('确认删除这道试题吗？', '提示', {\n        type: 'warning'\n      });\n      await request.delete('/examquestions/delete', {\n        data: [id]\n      });\n      await this.loadRows();\n    },\n    defaultForm() {\n      return {\n        paperId: '',\n        questionName: '',\n        questionType: 'single',\n        optionsJson: '[{\"key\":\"A\",\"value\":\"\"},{\"key\":\"B\",\"value\":\"\"},{\"key\":\"C\",\"value\":\"\"},{\"key\":\"D\",\"value\":\"\"}]',\n        answer: 'A',\n        analysis: '',\n        score: 5,\n        sort: 0\n      };\n    }\n  }\n};","map":{"version":3,"names":["request","data","keyword","paperId","papers","rows","dialogVisible","editing","form","defaultForm","computed","dialogTitle","created","loadPapers","loadRows","methods","res","get","params","page","limit","list","undefined","reset","openCreate","openEdit","row","Object","assign","applyTypeTemplate","questionType","optionsJson","answer","validate","questionName","trim","analysis","options","JSON","parse","Array","isArray","length","error","submit","$message","warning","put","post","remove","id","$confirm","type","delete","score","sort"],"sources":["D:/桌面文件/实训/online-teaching-platform/admin-web/src/views/QuestionPage.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>试题管理</h1>\n    <div class=\"toolbar\">\n      <el-input v-model=\"keyword\" placeholder=\"请输入试题关键词\" />\n      <el-select v-model=\"paperId\" clearable placeholder=\"按试卷筛选\">\n        <el-option v-for=\"paper in papers\" :key=\"paper.id\" :label=\"paper.name\" :value=\"paper.id\" />\n      </el-select>\n      <el-button type=\"primary\" @click=\"loadRows\">搜索</el-button>\n      <el-button @click=\"reset\">重置</el-button>\n      <el-button type=\"primary\" @click=\"openCreate\">新增</el-button>\n    </div>\n\n    <el-table :data=\"rows\" border>\n      <el-table-column prop=\"questionName\" label=\"题目\" min-width=\"220\" />\n      <el-table-column prop=\"paperName\" label=\"所属试卷\" width=\"160\" />\n      <el-table-column prop=\"questionType\" label=\"题型\" width=\"100\" />\n      <el-table-column prop=\"score\" label=\"分值\" width=\"80\" />\n      <el-table-column prop=\"answer\" label=\"答案\" width=\"120\" />\n      <el-table-column label=\"操作\" width=\"180\">\n        <template slot-scope=\"scope\">\n          <el-button size=\"mini\" @click=\"openEdit(scope.row)\">编辑</el-button>\n          <el-button size=\"mini\" type=\"danger\" @click=\"remove(scope.row.id)\">删除</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"680px\">\n      <el-form label-width=\"90px\">\n        <el-form-item label=\"所属试卷\">\n          <el-select v-model=\"form.paperId\" placeholder=\"请选择试卷\">\n            <el-option v-for=\"paper in papers\" :key=\"paper.id\" :label=\"paper.name\" :value=\"paper.id\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"题型\">\n          <el-select v-model=\"form.questionType\" @change=\"applyTypeTemplate\">\n            <el-option label=\"单选题\" value=\"single\" />\n            <el-option label=\"多选题\" value=\"multiple\" />\n            <el-option label=\"判断题\" value=\"judge\" />\n            <el-option label=\"填空题\" value=\"fill\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"题目\">\n          <el-input v-model=\"form.questionName\" type=\"textarea\" />\n        </el-form-item>\n        <el-form-item label=\"选项JSON\">\n          <el-input v-model=\"form.optionsJson\" type=\"textarea\" :rows=\"4\" />\n        </el-form-item>\n        <el-form-item label=\"答案\">\n          <el-input v-model=\"form.answer\" placeholder=\"多选用英文逗号分隔，如 A,B,D\" />\n        </el-form-item>\n        <el-form-item label=\"解析\">\n          <el-input v-model=\"form.analysis\" type=\"textarea\" />\n        </el-form-item>\n        <el-form-item label=\"分值\">\n          <el-input-number v-model=\"form.score\" :min=\"1\" />\n        </el-form-item>\n        <el-form-item label=\"排序\">\n          <el-input-number v-model=\"form.sort\" :min=\"0\" />\n        </el-form-item>\n      </el-form>\n\n      <span slot=\"footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submit\">保存</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport request from '../api/request'\n\nexport default {\n  data() {\n    return {\n      keyword: '',\n      paperId: '',\n      papers: [],\n      rows: [],\n      dialogVisible: false,\n      editing: false,\n      form: this.defaultForm()\n    }\n  },\n  computed: {\n    dialogTitle() {\n      return this.editing ? '编辑试题' : '新增试题'\n    }\n  },\n  async created() {\n    await this.loadPapers()\n    await this.loadRows()\n  },\n  methods: {\n    async loadPapers() {\n      const res = await request.get('/exampapers/page', { params: { page: 1, limit: 100 } })\n      this.papers = res.data.data.list\n    },\n    async loadRows() {\n      const res = await request.get('/examquestions/page', {\n        params: { page: 1, limit: 20, keyword: this.keyword, paperId: this.paperId || undefined }\n      })\n      this.rows = res.data.data.list\n    },\n    reset() {\n      this.keyword = ''\n      this.paperId = ''\n      this.loadRows()\n    },\n    openCreate() {\n      this.editing = false\n      this.form = this.defaultForm()\n      this.dialogVisible = true\n    },\n    openEdit(row) {\n      this.editing = true\n      this.form = Object.assign(this.defaultForm(), row)\n      this.dialogVisible = true\n    },\n    applyTypeTemplate() {\n      if (this.form.questionType === 'judge') {\n        this.form.optionsJson = '[{\"key\":\"A\",\"value\":\"对\"},{\"key\":\"B\",\"value\":\"错\"}]'\n        this.form.answer = 'A'\n      } else if (this.form.questionType === 'fill') {\n        this.form.optionsJson = '[]'\n      } else if (!this.form.optionsJson || this.form.optionsJson === '[]') {\n        this.form.optionsJson = '[{\"key\":\"A\",\"value\":\"\"},{\"key\":\"B\",\"value\":\"\"},{\"key\":\"C\",\"value\":\"\"},{\"key\":\"D\",\"value\":\"\"}]'\n      }\n    },\n    validate() {\n      if (!this.form.paperId) return '请选择所属试卷'\n      if (!this.form.questionName.trim()) return '请输入题目'\n      if (!this.form.answer.trim()) return '请输入答案'\n      if (!this.form.analysis.trim()) return '请输入题目解析'\n      try {\n        const options = JSON.parse(this.form.optionsJson || '[]')\n        if ((this.form.questionType === 'single' || this.form.questionType === 'multiple') && (!Array.isArray(options) || options.length < 2)) {\n          return '单选题和多选题至少需要两个选项'\n        }\n        if (this.form.questionType === 'judge' && (!Array.isArray(options) || options.length !== 2)) {\n          return '判断题必须保留两个选项'\n        }\n      } catch (error) {\n        return '选项JSON格式不正确'\n      }\n      return ''\n    },\n    async submit() {\n      const error = this.validate()\n      if (error) {\n        this.$message.warning(error)\n        return\n      }\n      if (this.editing) {\n        await request.put('/examquestions/update', this.form)\n      } else {\n        await request.post('/examquestions/save', this.form)\n      }\n      this.dialogVisible = false\n      await this.loadRows()\n    },\n    async remove(id) {\n      await this.$confirm('确认删除这道试题吗？', '提示', { type: 'warning' })\n      await request.delete('/examquestions/delete', { data: [id] })\n      await this.loadRows()\n    },\n    defaultForm() {\n      return {\n        paperId: '',\n        questionName: '',\n        questionType: 'single',\n        optionsJson: '[{\"key\":\"A\",\"value\":\"\"},{\"key\":\"B\",\"value\":\"\"},{\"key\":\"C\",\"value\":\"\"},{\"key\":\"D\",\"value\":\"\"}]',\n        answer: 'A',\n        analysis: '',\n        score: 5,\n        sort: 0\n      }\n    }\n  }\n}\n</script>\n"],"mappings":"AAuEA,OAAAA,OAAA;AAEA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,OAAA;MACAC,MAAA;MACAC,IAAA;MACAC,aAAA;MACAC,OAAA;MACAC,IAAA,OAAAC,WAAA;IACA;EACA;EACAC,QAAA;IACAC,YAAA;MACA,YAAAJ,OAAA;IACA;EACA;EACA,MAAAK,QAAA;IACA,WAAAC,UAAA;IACA,WAAAC,QAAA;EACA;EACAC,OAAA;IACA,MAAAF,WAAA;MACA,MAAAG,GAAA,SAAAhB,OAAA,CAAAiB,GAAA;QAAAC,MAAA;UAAAC,IAAA;UAAAC,KAAA;QAAA;MAAA;MACA,KAAAhB,MAAA,GAAAY,GAAA,CAAAf,IAAA,CAAAA,IAAA,CAAAoB,IAAA;IACA;IACA,MAAAP,SAAA;MACA,MAAAE,GAAA,SAAAhB,OAAA,CAAAiB,GAAA;QACAC,MAAA;UAAAC,IAAA;UAAAC,KAAA;UAAAlB,OAAA,OAAAA,OAAA;UAAAC,OAAA,OAAAA,OAAA,IAAAmB;QAAA;MACA;MACA,KAAAjB,IAAA,GAAAW,GAAA,CAAAf,IAAA,CAAAA,IAAA,CAAAoB,IAAA;IACA;IACAE,MAAA;MACA,KAAArB,OAAA;MACA,KAAAC,OAAA;MACA,KAAAW,QAAA;IACA;IACAU,WAAA;MACA,KAAAjB,OAAA;MACA,KAAAC,IAAA,QAAAC,WAAA;MACA,KAAAH,aAAA;IACA;IACAmB,SAAAC,GAAA;MACA,KAAAnB,OAAA;MACA,KAAAC,IAAA,GAAAmB,MAAA,CAAAC,MAAA,MAAAnB,WAAA,IAAAiB,GAAA;MACA,KAAApB,aAAA;IACA;IACAuB,kBAAA;MACA,SAAArB,IAAA,CAAAsB,YAAA;QACA,KAAAtB,IAAA,CAAAuB,WAAA;QACA,KAAAvB,I